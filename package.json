{
  "name": "cp949-react-highlight-words-workspace",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/cp949/react-highlight-words.git"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "format": "oxfmt",
    "check-types": "turbo run check-types",
    "test": "pnpm --filter @cp949/react-highlight-words test:run",
    "release:check": "pnpm lint && pnpm check-types && pnpm test && pnpm build && pnpm --filter @cp949/react-highlight-words pack:dry-run",
    "publish:npm": "pnpm --filter @cp949/react-highlight-words publish:npm"
  },
  "devDependencies": {
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "turbo": "^2.11.11",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20.19.0"
  }
}
